order_4 = Order(ordernumber="DEL123456789", itemcode="ITM004", description="Camera Lock", quantity=3, unitprice=15.00)
order_1.displayOrder()
order_2.displayOrder()
order_3.displayOrder()
order_4.displayOrder()

# Creating and displaying CalculatedCharges
calculated_charges_example = CalculatedCharges(subtotal=270.00, taxesandfees=13.50, currency="AED")
calculated_charges_example.displayCalculatedCharges()

# Creating and displaying ReturnRequest
return_request_example = ReturnRequest(
    ordernumber="DEL123456789", returnreason="Changed my mind",
    returnstatus="Pending", returndate="January 27, 2025", refundamount=195.00
)
return_request_example.displayReturnRequest()

# Creating and displaying SchedulePickUp
schedule_pickup_example = SchedulePickUp(
    ordernumber="DEL123456790", pickupaddress="45 Knowledge Avenue, Dubai, UAE",
    pickupdate="February 10, 2025", timeslot="9:00 AM - 11:00 AM",
    assigneddeliverystaff="Ahmed Alhashmi"
)
schedule_pickup_example.displayShedulePickup()
